[sub_resource type="Resource" id="DialogueLine_forgeron_01"]
script = ExtResource("14_dtot8")
speaker_name = "Zylrak"
portrait = ExtResource("p_z_sourire_en_coin")
text = "Alors c'est toi, le fameux forgeron dont tout Karn parle ? J'avoue, je m'attendais à quelqu'un de plus... impressionnant."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_02"]
script = ExtResource("14_dtot8")
speaker_name = "Forgeron"
portrait = ExtResource("p_f_boit")
text = "Et toi, t'es qui pour venir me faire ce genre de remarque chez moi ?"
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_03"]
script = ExtResource("14_dtot8")
speaker_name = "Zylrak"
portrait = ExtResource("p_z_fier")
text = "Zylrak. Ashwarden de l'Ordre des Cendres. Retiens bien ce nom : bientôt, on le chantera dans toutes les tavernes de Karn."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_04"]
script = ExtResource("14_dtot8")
speaker_name = "Forgeron"
portrait = ExtResource("p_f_hautain")
text = "Jamais entendu parler."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_05"]
script = ExtResource("14_dtot8")
speaker_name = "Forgeron"
portrait = ExtResource("p_f_sceptique")
text = "Des gamins qui se prennent pour des légendes, j'en vois passer tous les mois. La plupart finissent la gueule dans un caniveau."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_06"]
script = ExtResource("14_dtot8")
speaker_name = "Zylrak"
portrait = ExtResource("p_z_colre")
text = "« Qui se prennent pour »... ? Attends un peu, toi. Un jour, mon nom sera gravé sur les plus belles lames du royaume. Et c'est toi qui me supplieras de les forger !"
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_07"]
script = ExtResource("14_dtot8")
speaker_name = "Forgeron"
portrait = ExtResource("p_f_rire")
text = "Ha ! Tant que tu payes, gamin, je te grave même le nom de ta mère."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_08"]
script = ExtResource("14_dtot8")
speaker_name = "Forgeron"
portrait = ExtResource("p_f_agace")
text = "Bon. À part me faire perdre mon temps à t'écouter parler de toi, qu'est-ce que tu viens chercher ici ?"
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_09"]
script = ExtResource("14_dtot8")
speaker_name = "Zylrak"
portrait = ExtResource("p_z_embarrass")
text = "..."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_10"]
script = ExtResource("14_dtot8")
speaker_name = "Zylrak"
portrait = ExtResource("p_z_determin")
text = "Une lame. Une vraie. Pas un de ces cure-dents que tu vends aux gardes du village. Tu te crois capable de forger une épée à ma hauteur ?"
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_11"]
script = ExtResource("14_dtot8")
speaker_name = "Forgeron"
portrait = ExtResource("p_f_colere")
text = "Tu commences sérieusement à me chauffer. Des armes comme les miennes, t'en trouveras nulle part ailleurs dans Karn."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_12"]
script = ExtResource("14_dtot8")
speaker_name = "Forgeron"
portrait = ExtResource("p_f_serieux")
text = "Tiens. Équilibrée, trempée trois fois, aussi tranchante que ta langue. Ça fera 12 000 écus."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_13"]
script = ExtResource("14_dtot8")
speaker_name = "Zylrak"
portrait = ExtResource("p_z_rire")
text = "Ha... 12 000 ? Évidemment. C'est pile le prix que j'avais en tête."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_14"]
script = ExtResource("14_dtot8")
speaker_name = "Zylrak"
portrait = ExtResource("p_z_sourire_en_coin")
text = "Merci, l'ami. Je la couvrirai du sang de mes ennemis... et je dirai à tout le monde d'où elle vient."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

[sub_resource type="Resource" id="DialogueLine_forgeron_15"]
script = ExtResource("14_dtot8")
speaker_name = "Forgeron"
portrait = ExtResource("p_f_sourire")
text = "Ramène-la-moi entière, et peut-être que je retiendrai ton nom."
metadata/_custom_type_script = "uid://d30cvftsqiqkj"

