[sub_resource type="Resource" id="Resource_81whq"]
script = ExtResource("14_yr0co")
speaker_name = "Zylrak"
portrait = ExtResource("15_q1hfv")
text = "La route de l'est... Elle mène aux ruines. C'est par là que le marchand devait arriver."

[sub_resource type="Resource" id="Resource_4e5ex"]
script = ExtResource("14_yr0co")
speaker_name = "Zylrak"
portrait = ExtResource("16_432yp")
text = "Pas tout de suite. Mieux vaut que je sois prêt avant de m'y aventurer."

[sub_resource type="RectangleShape2D" id="RectangleShape2D_akfi3"]
size = Vector2(32, 288)

[sub_resource type="Resource" id="Resource_rnmsu"]
script = ExtResource("14_yr0co")
speaker_name = "Zylrak"
portrait = ExtResource("16_432yp")
text = "Ce chemin descend vers le lac. Aldric allait souvent couper du bois par là..."

[sub_resource type="Resource" id="Resource_b3rjh"]
script = ExtResource("14_yr0co")
speaker_name = "Zylrak"
portrait = ExtResource("17_mpjun")
text = "Je reviendrai quand je saurai quoi chercher."

[sub_resource type="RectangleShape2D" id="RectangleShape2D_ulhen"]
size = Vector2(32, 288)

[sub_resource type="Resource" id="Resource_75fis"]
script = ExtResource("14_yr0co")
speaker_name = "Zylrak"
portrait = ExtResource("16_432yp")
text = "Une grotte... Il fait noir comme dans un four là-dedans."

[sub_resource type="Resource" id="Resource_8m8ps"]
script = ExtResource("14_yr0co")
speaker_name = "Zylrak"
portrait = ExtResource("17_mpjun")
text = "Sans torche, je n'irai pas bien loin. Je reviendrai plus tard."

