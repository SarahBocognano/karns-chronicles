[sub_resource type="Resource" id="Resource_aytr8"]
script = ExtResource("23_cltab")
speaker_name = "Zylrak"
portrait = ExtResource("24_lr17u")
text = "La route de l'est... Elle mène aux ruines. C'est par là que le marchand devait arriver."

[sub_resource type="Resource" id="Resource_tmisi"]
script = ExtResource("23_cltab")
speaker_name = "Zylrak"
portrait = ExtResource("25_oodh8")
text = "Pas tout de suite. Mieux vaut que je sois prêt avant de m'y aventurer."

[sub_resource type="RectangleShape2D" id="RectangleShape2D_d6otf"]
size = Vector2(32, 288)

[sub_resource type="Resource" id="Resource_rl30p"]
script = ExtResource("23_cltab")
speaker_name = "Zylrak"
portrait = ExtResource("25_oodh8")
text = "Ce chemin descend vers le lac. Aldric allait souvent couper du bois par là..."

[sub_resource type="Resource" id="Resource_vlxig"]
script = ExtResource("23_cltab")
speaker_name = "Zylrak"
portrait = ExtResource("26_a4nlf")
text = "Je reviendrai quand je saurai quoi chercher."

[sub_resource type="RectangleShape2D" id="RectangleShape2D_nq82j"]
size = Vector2(32, 288)

[sub_resource type="Resource" id="Resource_wv8h6"]
script = ExtResource("23_cltab")
speaker_name = "Zylrak"
portrait = ExtResource("25_oodh8")
text = "Une grotte... Il fait noir comme dans un four là-dedans."

[sub_resource type="Resource" id="Resource_8bmly"]
script = ExtResource("23_cltab")
speaker_name = "Zylrak"
portrait = ExtResource("26_a4nlf")
text = "Sans torche, je n'irai pas bien loin. Je reviendrai plus tard."

