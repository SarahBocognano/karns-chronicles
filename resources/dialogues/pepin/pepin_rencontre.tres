[sub_resource type="Resource" id="Resource_p5i27"]
script = ExtResource("1_ealpo")
speaker_name = "Pépin"
portrait = ExtResource("2_i1pnq")
text = "Hahaha ! T'as vu ta cape ? On dirait le vieux rideau de la mère Margot !"

[sub_resource type="Resource" id="Resource_bfpu1"]
script = ExtResource("1_ealpo")
speaker_name = "Zylrak"
portrait = ExtResource("3_vsysj")
text = "C'est la cape de l'Ordre des Cendres, morveux."

[sub_resource type="Resource" id="Resource_vgbd5"]
script = ExtResource("1_ealpo")
speaker_name = "Pépin"
portrait = ExtResource("4_tr4fp")
text = "L'Ordre des quoi ? Des cendres ? Comme dans la cheminée ?"

[sub_resource type="Resource" id="Resource_1t4eg"]
script = ExtResource("1_ealpo")
speaker_name = "Zylrak"
portrait = ExtResource("5_gythl")
text = "... Comme dans la légende. Laisse tomber."

[sub_resource type="Resource" id="Resource_qe04v"]
script = ExtResource("1_ealpo")
speaker_name = "Pépin"
portrait = ExtResource("6_8mfr7")
text = "Wouah, t'es un vrai chevalier ? T'as déjà tué un dragon ? Un troll ? Une poule ?"

[sub_resource type="Resource" id="Resource_ayhkr"]
script = ExtResource("1_ealpo")
speaker_name = "Zylrak"
portrait = ExtResource("7_ujwi2")
text = "Des dizaines. Enfin... pas de poules."

[sub_resource type="Resource" id="Resource_sq75s"]
script = ExtResource("1_ealpo")
speaker_name = "Pépin"
portrait = ExtResource("8_hremr")
text = "Pfff. T'as même pas une égratignure. Moi j'dis que t'as jamais rien tué du tout."

[sub_resource type="Resource" id="Resource_18ulj"]
script = ExtResource("1_ealpo")
speaker_name = "Pépin"
portrait = ExtResource("2_i1pnq")
text = "Allez, salut, le chevalier des cheminées ! Et fais gaffe à ta bourse, y a des voleurs dans le coin, hihi !"

[sub_resource type="Resource" id="Resource_olcbw"]
script = ExtResource("1_ealpo")
speaker_name = "Zylrak"
portrait = ExtResource("9_atntd")
text = "... Pourquoi j'ai l'impression qu'il parlait de lui ?"

