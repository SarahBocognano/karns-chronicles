[gd_resource type="Resource" script_class="DialogueConversation" format=3]

[ext_resource type="Script" path="res://scenes/Dialog/dialog_lines.gd" id="1_lines"]
[ext_resource type="Script" path="res://scenes/Dialog/dialogue_conversation.gd" id="2_conv"]
[ext_resource type="Texture2D" path="res://assets/portrait/aldric_blesse.tres" id="p0"]
[ext_resource type="Texture2D" path="res://assets/portrait/zylrak_sourire_en_coin.tres" id="p1"]
[ext_resource type="Texture2D" path="res://assets/portrait/aldric_sourire.tres" id="p2"]
[ext_resource type="Texture2D" path="res://assets/portrait/zylrak_determiné.tres" id="p3"]
[ext_resource type="Texture2D" path="res://assets/portrait/aldric_neutre.tres" id="p4"]
[ext_resource type="Texture2D" path="res://assets/portrait/zylrak_colère.tres" id="p5"]

[sub_resource type="Resource" id="Resource_l0"]
script = ExtResource("1_lines")
text = "Contre l'arbre mort, un homme est assis, une hache sur les genoux. Sa jambe est entourée d'un chiffon rougi."

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_lines")
speaker_name = "Aldric"
portrait = ExtResource("p0")
text = "Qui va là ?! ... Ah. T'as pas une tête de goule, toi."

[sub_resource type="Resource" id="Resource_l2"]
script = ExtResource("1_lines")
speaker_name = "Zylrak"
portrait = ExtResource("p1")
text = "Zylrak, Ashwarden de l'Ordre des Cendres. C'est ta sœur qui m'envoie."

[sub_resource type="Resource" id="Resource_l3"]
script = ExtResource("1_lines")
speaker_name = "Aldric"
portrait = ExtResource("p2")
text = "Brenna... Évidemment, Brenna. Elle a dû retourner tout le village."

[sub_resource type="Resource" id="Resource_l4"]
script = ExtResource("1_lines")
speaker_name = "Aldric"
portrait = ExtResource("p0")
text = "Il y a trois nuits, des hommes en capuche sont venus sur la rive. Des lanternes, des chants... Ils ont tracé quelque chose dans la boue, près du panneau à la tête de loup."

[sub_resource type="Resource" id="Resource_l5"]
script = ExtResource("1_lines")
speaker_name = "Aldric"
portrait = ExtResource("p0")
text = "Et puis les goules sont sorties de la brume. Pas pour eux : pour moi. Comme si on les avait lâchées."

[sub_resource type="Resource" id="Resource_l6"]
script = ExtResource("1_lines")
speaker_name = "Zylrak"
portrait = ExtResource("p3")
text = "Des hommes en capuche qui commandent aux goules... Ça ne me plaît pas du tout."

[sub_resource type="Resource" id="Resource_l7"]
script = ExtResource("1_lines")
speaker_name = "Aldric"
portrait = ExtResource("p4")
text = "J'ai pris la barque du ponton et j'ai ramé jusqu'ici. Ma jambe n'a pas aimé la course."

[sub_resource type="Resource" id="Resource_l8"]
script = ExtResource("1_lines")
text = "L'eau frémit autour de l'île. Des silhouettes grises émergent de la brume, ruisselantes."

[sub_resource type="Resource" id="Resource_l9"]
script = ExtResource("1_lines")
speaker_name = "Aldric"
portrait = ExtResource("p0")
text = "Les revoilà ! Celle du milieu, c'est elle qui m'a mordu !"

[sub_resource type="Resource" id="Resource_l10"]
script = ExtResource("1_lines")
speaker_name = "Zylrak"
portrait = ExtResource("p5")
text = "Reste derrière moi."

[resource]
script = ExtResource("2_conv")
lines = Array[ExtResource("1_lines")]([SubResource("Resource_l0"), SubResource("Resource_l1"), SubResource("Resource_l2"), SubResource("Resource_l3"), SubResource("Resource_l4"), SubResource("Resource_l5"), SubResource("Resource_l6"), SubResource("Resource_l7"), SubResource("Resource_l8"), SubResource("Resource_l9"), SubResource("Resource_l10")])
