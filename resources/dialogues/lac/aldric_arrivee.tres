[sub_resource type="Resource" id="Resource_l0"]
script = ExtResource("1_lines")
text = "La brume traîne sur l'eau. Pas un oiseau, pas une rame : le lac retient son souffle."

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_lines")
speaker_name = "Zylrak"
portrait = ExtResource("p0")
text = "Aldric coupait du bois par ici. Sa clairière doit être à l'ouest, au bout du chemin."

[resource]
script = ExtResource("2_conv")
lines = Array[ExtResource("1_lines")]([SubResource("Resource_l0"), SubResource("Resource_l1")])
