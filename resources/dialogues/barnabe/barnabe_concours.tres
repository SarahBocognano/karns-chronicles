[ext_resource type="Script" uid="uid://d30cvftsqiqkj" path="res://scenes/Dialog/dialog_lines.gd" id="1_srjcs"]
[ext_resource type="Texture2D" uid="uid://ci4k1gnvpyv2b" path="res://assets/portrait/zylrak_fier.tres" id="2_2yk4j"]
[ext_resource type="Texture2D" uid="uid://egasqgnvdf2m" path="res://assets/portrait/barnabe_hilare.tres" id="2_ddi8m"]
[ext_resource type="Texture2D" uid="uid://cpluhr7ep0qqy" path="res://assets/portrait/zylrak_sourire_en_coin.tres" id="3_i5xjx"]
