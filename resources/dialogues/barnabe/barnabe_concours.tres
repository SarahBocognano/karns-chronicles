[ext_resource type="Texture2D" uid="uid://bka40xsiissl6" path="res://assets/portrait/barnabe_surpris.tres" id="6_x3kfp"]
[ext_resource type="Texture2D" uid="uid://5iuxjlc2fcej" path="res://assets/portrait/barnabe_ivre.tres" id="7_s86mo"]
