[sub_resource type="Resource" id="Resource_x3kfp"]
script = ExtResource("1_srjcs")
speaker_name = "Barnabé"
portrait = ExtResource("2_ddi8m")
text = "Hé, toi ! La cape ! T'as une tête à tenir l'alcool. Enfin... à croire que tu le tiens."

[sub_resource type="Resource" id="Resource_s86mo"]
script = ExtResource("1_srjcs")
speaker_name = "Zylrak"
portrait = ExtResource("2_2yk4j")
text = "Je tiens tout. L'alcool, l'épée, et ma réputation."

[sub_resource type="Resource" id="Resource_a63vo"]
script = ExtResource("1_srjcs")
speaker_name = "Barnabé"
portrait = ExtResource("2_ddi8m")
text = "Barnabé ! Champion de la chope trois hivers de suite. Un concours, l'Ashwarden ? Le perdant paie la tournée."

[sub_resource type="Resource" id="Resource_6x5dx"]
script = ExtResource("1_srjcs")
speaker_name = "Zylrak"
portrait = ExtResource("3_i5xjx")
text = "T'as pas idée de ce que tu viens de faire."

[sub_resource type="Resource" id="Resource_rnmik"]
script = ExtResource("1_srjcs")
text = "Quelques chopes plus tard..."

[sub_resource type="Resource" id="Resource_eufmt"]
script = ExtResource("1_srjcs")
speaker_name = "Zylrak"
portrait = ExtResource("4_w82et")
text = "J'te jure... l'auberge, elle tourne. C'est elle qui triche."

[sub_resource type="Resource" id="Resource_rojk5"]
script = ExtResource("1_srjcs")
speaker_name = "Barnabé"
portrait = ExtResource("6_x3kfp")
text = "Attends... t'en as bu combien, toi ?"

[sub_resource type="Resource" id="Resource_hp3fl"]
script = ExtResource("1_srjcs")
speaker_name = "Zylrak"
portrait = ExtResource("4_w82et")
text = "Quatre ! ... Ou deux. Deux fois deux."

[sub_resource type="Resource" id="Resource_oiwtp"]
script = ExtResource("1_srjcs")
speaker_name = "Barnabé"
portrait = ExtResource("7_s86mo")
text = "J'en suis à neuf ! Ha ! Tu paies la tournée, gardien des chopes vides !"

[sub_resource type="Resource" id="Resource_kmnjb"]
script = ExtResource("1_srjcs")
speaker_name = "Zylrak"
portrait = ExtResource("5_ddi8m")
text = "On dira à personne que l'Ashwarden a perdu contre un type qui s'appelle Barnabé."

[sub_resource type="Resource" id="Resource_mc1bp"]
script = ExtResource("1_srjcs")
speaker_name = "Barnabé"
portrait = ExtResource("9_a63vo")
text = "Hé ! C'est un très beau prénom, Barnabé !"

[resource]
