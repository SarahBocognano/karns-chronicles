[ext_resource type="Texture2D" uid="uid://igwo1ueraan1" path="res://assets/portrait/brenna_triste.tres" id="2_jsf7g"]
[ext_resource type="Texture2D" uid="uid://bl2ddbq03v35k" path="res://assets/portrait/zylrak_normal.tres" id="3_e27ke"]
[ext_resource type="Texture2D" uid="uid://6if08xlylmun" path="res://assets/portrait/zylrak_reflexion.tres" id="4_ymbte"]
[ext_resource type="Texture2D" uid="uid://bovq46417yatt" path="res://assets/portrait/brenna_fachee.tres" id="5_0pxy5"]
[ext_resource type="Texture2D" uid="uid://b6ihvptd1t3iv" path="res://assets/portrait/brenna_timide.tres" id="6_qqkig"]
[ext_resource type="Texture2D" uid="uid://b82h2yree0n6j" path="res://assets/portrait/zylrak_determiné.tres" id="7_e5dk1"]
[ext_resource type="Texture2D" uid="uid://cpluhr7ep0qqy" path="res://assets/portrait/zylrak_sourire_en_coin.tres" id="8_gcm50"]
