[sub_resource type="Resource" id="Resource_ym4sh"]
script = ExtResource("1_j368f")
speaker_name = "Brenna"
portrait = ExtResource("2_jsf7g")
text = "Zylrak... attends. Je peux te parler ?"

[sub_resource type="Resource" id="Resource_8hg00"]
script = ExtResource("1_j368f")
speaker_name = "Zylrak"
portrait = ExtResource("3_e27ke")
text = "Tiens, plus de moqueries ? Ça doit être sérieux."

[sub_resource type="Resource" id="Resource_qtno6"]
script = ExtResource("1_j368f")
speaker_name = "Brenna"
portrait = ExtResource("2_jsf7g")
text = "C'est mon frère, Aldric. Il est parti couper du bois dans la forêt il y a deux jours. Il n'est jamais rentré."

[sub_resource type="Resource" id="Resource_5i5vc"]
script = ExtResource("1_j368f")
speaker_name = "Zylrak"
portrait = ExtResource("4_ymbte")
text = "Deux jours... avec les goules qui rôdent dans le coin."

[sub_resource type="Resource" id="Resource_onwva"]
script = ExtResource("1_j368f")
speaker_name = "Brenna"
portrait = ExtResource("5_0pxy5")
text = "Je sais ! Et personne au village ne veut aller le chercher. Ils ont tous trop peur."

[sub_resource type="Resource" id="Resource_qy53t"]
script = ExtResource("1_j368f")
speaker_name = "Brenna"
portrait = ExtResource("6_qqkig")
text = "Toi, tu n'as peur de rien, pas vrai ? Enfin... c'est ce que tu racontes à tout le monde."

[sub_resource type="Resource" id="Resource_k2mg0"]
script = ExtResource("1_j368f")
speaker_name = "Zylrak"
portrait = ExtResource("7_e5dk1")
text = "Je vais te le ramener, ton frère."

[sub_resource type="Resource" id="Resource_xd80p"]
script = ExtResource("1_j368f")
speaker_name = "Brenna"
portrait = ExtResource("6_qqkig")
text = "Merci... Et cette fois, je te promets de retenir ton nom."

[sub_resource type="Resource" id="Resource_7nww7"]
script = ExtResource("1_j368f")
speaker_name = "Zylrak"
portrait = ExtResource("8_gcm50")
text = "Je savais que tu finirais par craquer."

[sub_resource type="Resource" id="Resource_sunsy"]
script = ExtResource("1_j368f")
speaker_name = "Brenna"
portrait = ExtResource("9_su52i")
text = "N'en profite pas, Ashwarden."

[resource]
script = ExtResource("10_xhv6y")
lines = Array[ExtResource("1_j368f")]([SubResource("Resource_ym4sh"), SubResource("Resource_8hg00"), SubResource("Resource_qtno6"), SubResource("Resource_5i5vc"), SubResource("Resource_onwva"), SubResource("Resource_qy53t"), SubResource("Resource_k2mg0"), SubResource("Resource_xd80p"), SubResource("Resource_7nww7"), SubResource("Resource_sunsy")])
required_flags = Array[String](["talked_to_brenna", "has_accepted_zylrak_quest"])
