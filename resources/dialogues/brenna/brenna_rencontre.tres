[ext_resource type="Texture2D" uid="uid://d3n20nd4cot58" path="res://assets/portrait/brenna_malicieuse.tres" id="2_2i4kf"]
[ext_resource type="Texture2D" uid="uid://ci4k1gnvpyv2b" path="res://assets/portrait/zylrak_fier.tres" id="3_1r0rc"]
[ext_resource type="Texture2D" uid="uid://7u07244vqfxq" path="res://assets/portrait/brenna_rire.tres" id="4_n0j1m"]
[ext_resource type="Texture2D" uid="uid://3fdfomk8sevn" path="res://assets/portrait/zylrak_colère.tres" id="5_veqcr"]
[ext_resource type="Texture2D" uid="uid://dji0wg4g1p7an" path="res://assets/portrait/brenna_mefiante.tres" id="6_yh0vp"]
[ext_resource type="Texture2D" uid="uid://di7mlxwll8ovy" path="res://assets/portrait/zylrak_embarrassé.tres" id="7_cjery"]
[ext_resource type="Texture2D" uid="uid://6if08xlylmun" path="res://assets/portrait/zylrak_reflexion.tres" id="8_se3lx"]
