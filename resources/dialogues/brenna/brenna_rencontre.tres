[sub_resource type="Resource" id="Resource_emybt"]
script = ExtResource("1_4g4tg")
speaker_name = "Brenna"
portrait = ExtResource("2_2i4kf")
text = "Tiens, tiens... Le grand Ashwarden qui a crié son nom sur toute la place du village ?"

[sub_resource type="Resource" id="Resource_5fluo"]
script = ExtResource("1_4g4tg")
speaker_name = "Zylrak"
portrait = ExtResource("3_1r0rc")
text = "Les nouvelles vont vite. C'est normal, quand on est quelqu'un d'important."

[sub_resource type="Resource" id="Resource_88cp7"]
script = ExtResource("1_4g4tg")
speaker_name = "Brenna"
portrait = ExtResource("4_n0j1m")
text = "Ou quand on parle très, très fort."

[sub_resource type="Resource" id="Resource_f3q5a"]
script = ExtResource("1_4g4tg")
speaker_name = "Zylrak"
portrait = ExtResource("5_veqcr")
text = "Hé ! Je ne parle pas fort. Je parle avec... conviction."

[sub_resource type="Resource" id="Resource_s0cy3"]
script = ExtResource("1_4g4tg")
speaker_name = "Brenna"
portrait = ExtResource("6_yh0vp")
text = "Mmh. Tu sais ce que je crois ? Ceux qui répètent leur nom à tout bout de champ..."

[sub_resource type="Resource" id="Resource_dxtni"]
script = ExtResource("1_4g4tg")
speaker_name = "Brenna"
portrait = ExtResource("2_2i4kf")
text = "... c'est qu'ils ont peur qu'on les oublie."

[sub_resource type="Resource" id="Resource_evl75"]
script = ExtResource("1_4g4tg")
speaker_name = "Zylrak"
portrait = ExtResource("7_cjery")
text = "..."

[sub_resource type="Resource" id="Resource_u47vx"]
script = ExtResource("1_4g4tg")
speaker_name = "Zylrak"
portrait = ExtResource("8_se3lx")
text = "Et toi, tu as un nom, ou tu passes tes journées à lire dans la tête des gens ?"

[sub_resource type="Resource" id="Resource_tjd26"]
script = ExtResource("1_4g4tg")
speaker_name = "Brenna"
portrait = ExtResource("9_jedx2")
text = "Brenna. Et rassure-toi, le tien, je risque pas de l'oublier. Tu l'as crié trois fois."

[resource]
