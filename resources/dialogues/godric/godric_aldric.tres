[sub_resource type="Resource" id="Resource_5yv7j"]
script = ExtResource("1_1l2ya")
speaker_name = "Zylrak"
portrait = ExtResource("2_635jo")
text = "C'est toi, Godric ? Brenna dit que c'est toi qui as élevé Aldric."

[sub_resource type="Resource" id="Resource_2arda"]
script = ExtResource("1_1l2ya")
speaker_name = "Godric"
portrait = ExtResource("3_iaqhx")
text = "Élevé... disons que j'ai essayé. Ce gamin est aussi têtu que l'était son père, paix à son âme."

[sub_resource type="Resource" id="Resource_sj4fm"]
script = ExtResource("1_1l2ya")
speaker_name = "Godric"
portrait = ExtResource("4_8uju1")
text = "C'est moi qui lui ai mis sa première hache entre les mains. Il avait huit ans, il pouvait à peine la soulever."

[sub_resource type="Resource" id="Resource_u44j7"]
script = ExtResource("1_1l2ya")
speaker_name = "Godric"
portrait = ExtResource("5_eq47t")
text = "Aujourd'hui, il abat un chêne plus vite que moi. Et il ne se prive pas de me le rappeler."

[sub_resource type="Resource" id="Resource_lxako"]
script = ExtResource("1_1l2ya")
speaker_name = "Godric"
portrait = ExtResource("6_qp5oj")
text = "Il coupait au bord du lac, à l'ouest de la forêt. Le bois y est meilleur, mais le coin est mal fréquenté depuis quelque temps."

[sub_resource type="Resource" id="Resource_au4of"]
script = ExtResource("1_1l2ya")
speaker_name = "Zylrak"
portrait = ExtResource("7_1uqeg")
text = "Je le ramènerai. À Brenna, et à toi."

[sub_resource type="Resource" id="Resource_nb6ca"]
script = ExtResource("1_1l2ya")
speaker_name = "Godric"
portrait = ExtResource("3_iaqhx")
text = "Fais vite, Ashwarden. Je suis trop vieux pour enterrer encore quelqu'un de ma famille."

[resource]
script = ExtResource("8_bply5")
lines = Array[ExtResource("1_1l2ya")]([SubResource("Resource_5yv7j"), SubResource("Resource_2arda"), SubResource("Resource_sj4fm"), SubResource("Resource_u44j7"), SubResource("Resource_lxako"), SubResource("Resource_au4of"), SubResource("Resource_nb6ca")])
required_flags = Array[String](["aldric_quest_started"])
