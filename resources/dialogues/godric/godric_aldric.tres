[ext_resource type="Script" uid="uid://d30cvftsqiqkj" path="res://scenes/Dialog/dialog_lines.gd" id="1_1l2ya"]
[ext_resource type="Texture2D" uid="uid://6if08xlylmun" path="res://assets/portrait/zylrak_reflexion.tres" id="2_635jo"]
[ext_resource type="Texture2D" uid="uid://sdtijf3gc5aa" path="res://assets/portrait/godric_triste.tres" id="3_iaqhx"]
[ext_resource type="Texture2D" uid="uid://buer1knjw7hx5" path="res://assets/portrait/godric_neutre.tres" id="4_8uju1"]
[ext_resource type="Texture2D" uid="uid://c3b33txlnebms" path="res://assets/portrait/godric_sourire.tres" id="5_eq47t"]
[ext_resource type="Texture2D" uid="uid://4uin8wtfch1c" path="res://assets/portrait/godric_bougon.tres" id="6_qp5oj"]
[ext_resource type="Texture2D" uid="uid://b82h2yree0n6j" path="res://assets/portrait/zylrak_determiné.tres" id="7_1uqeg"]
