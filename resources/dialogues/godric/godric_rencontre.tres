[sub_resource type="Resource" id="Resource_5yj7b"]
script = ExtResource("1_xl8nw")
speaker_name = "Godric"
portrait = ExtResource("2_6r4fi")
text = "Hm. Un Ashwarden. Ça faisait longtemps qu'on n'en avait plus vu par ici."

[sub_resource type="Resource" id="Resource_exy45"]
script = ExtResource("1_xl8nw")
speaker_name = "Zylrak"
portrait = ExtResource("3_60vsr")
text = "Zylrak. Et je compte bien qu'on se souvienne de mon passage."

[sub_resource type="Resource" id="Resource_2f82d"]
script = ExtResource("1_xl8nw")
speaker_name = "Godric"
portrait = ExtResource("4_tfu5l")
text = "Ils disent tous ça, petit. Moi, je me souviens surtout de ceux qui reviennent."

[sub_resource type="Resource" id="Resource_j1tnc"]
script = ExtResource("1_xl8nw")
speaker_name = "Godric"
portrait = ExtResource("5_uv60u")
text = "Hors du village, tu n'es plus chez toi. Les bêtes rôdent partout : sur les chemins, dans les bois, dans les champs. Et elles n'attendent pas qu'on les voie."

[sub_resource type="Resource" id="Resource_3gwij"]
script = ExtResource("1_xl8nw")
speaker_name = "Zylrak"
portrait = ExtResource("6_t36lb")
text = "Qu'elles viennent. Mon épée a faim."

[sub_resource type="Resource" id="Resource_7a710"]
script = ExtResource("1_xl8nw")
speaker_name = "Godric"
portrait = ExtResource("2_6r4fi")
text = "Ton épée, peut-être. Mais garde les yeux ouverts quand même."

[resource]
script = ExtResource("7_jgxmu")
lines = Array[ExtResource("1_xl8nw")]([SubResource("Resource_5yj7b"), SubResource("Resource_exy45"), SubResource("Resource_2f82d"), SubResource("Resource_j1tnc"), SubResource("Resource_3gwij"), SubResource("Resource_7a710")])
forbidden_flags = Array[String](["talked_to_godric"])
flags_on_finish = Array[String](["talked_to_godric"])
