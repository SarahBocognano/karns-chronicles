[gd_resource type="Resource" script_class="DialogueConversation" format=3 uid="uid://y34mwms7ytwc"]

[ext_resource type="Script" uid="uid://d30cvftsqiqkj" path="res://scenes/Dialog/dialog_lines.gd" id="1_xl8nw"]
[ext_resource type="Texture2D" uid="uid://buer1knjw7hx5" path="res://assets/portrait/godric_neutre.tres" id="2_6r4fi"]
[ext_resource type="Texture2D" uid="uid://ci4k1gnvpyv2b" path="res://assets/portrait/zylrak_fier.tres" id="3_60vsr"]
[ext_resource type="Texture2D" uid="uid://c3b33txlnebms" path="res://assets/portrait/godric_sourire.tres" id="4_tfu5l"]
[ext_resource type="Texture2D" uid="uid://4uin8wtfch1c" path="res://assets/portrait/godric_bougon.tres" id="5_uv60u"]
[ext_resource type="Texture2D" uid="uid://b82h2yree0n6j" path="res://assets/portrait/zylrak_determiné.tres" id="6_t36lb"]
