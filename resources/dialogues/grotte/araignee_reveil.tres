[ext_resource type="Texture2D" path="res://assets/portrait/zylrak_determiné.tres" id="p0"]

[sub_resource type="Resource" id="Resource_l0"]
script = ExtResource("1_lines")
text = "Devant le filon, une masse sombre se déplie. Huit pattes, huit yeux, et des crochets longs comme des dagues."

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_lines")
speaker_name = "Zylrak"
portrait = ExtResource("p0")
text = "Elle est assise sur ma pierre. Évidemment."

[resource]
script = ExtResource("2_conv")
