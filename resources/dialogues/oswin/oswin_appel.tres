[sub_resource type="Resource" id="Resource_ydp5x"]
script = ExtResource("1_xop3p")
speaker_name = "Oswin"
portrait = ExtResource("2_ydp5x")
text = "Vous, là ! Avec la cape. Vous êtes bien un Ashwarden ?"

[sub_resource type="Resource" id="Resource_pri3b"]
script = ExtResource("1_xop3p")
speaker_name = "Zylrak"
portrait = ExtResource("2_llfem")
text = "En chair, en os et en cuir. Zylrak, de l'Ordre des Cendres. On parle déjà de moi jusqu'ici ?"

[sub_resource type="Resource" id="Resource_05xdi"]
script = ExtResource("1_xop3p")
speaker_name = "Oswin"
portrait = ExtResource("4_pri3b")
text = "De vous, non. Mais tout le monde connaît le symbole sur votre cape. Et on a besoin de quelqu'un comme vous."

[sub_resource type="Resource" id="Resource_qemya"]
script = ExtResource("1_xop3p")
speaker_name = "Oswin"
portrait = ExtResource("5_05xdi")
text = "Depuis des semaines, des goules rôdent autour du village. Les routes sont coupées, et plusieurs d'entre nous ont déjà été attaqués."

[sub_resource type="Resource" id="Resource_of43a"]
script = ExtResource("1_xop3p")
speaker_name = "Oswin"
portrait = ExtResource("6_qemya")
text = "Et le marchand qu'on attendait hier n'est jamais arrivé. Sans lui, plus de vivres, plus de remèdes... Le village ne tiendra pas longtemps."

[sub_resource type="Resource" id="Resource_lv5tr"]
script = ExtResource("1_xop3p")
speaker_name = "Zylrak"
portrait = ExtResource("3_i0734")
text = "Des goules, un marchand qui disparaît... Ça commence à ressembler à un contrat."

[sub_resource type="Resource" id="Resource_n60dh"]
script = ExtResource("1_xop3p")
speaker_name = "Oswin"
portrait = ExtResource("8_of43a")
text = "On n'a pas grand-chose, mais on paiera ce qu'on peut. Retrouvez-le, je vous en supplie."

[sub_resource type="Resource" id="Resource_q1cs2"]
script = ExtResource("1_xop3p")
speaker_name = "Zylrak"
portrait = ExtResource("4_hufkh")
text = "Garde ta bourse pour l'instant. Mais retiens bien le nom de celui qui va sauver ton village."

[sub_resource type="Resource" id="Resource_rhjqd"]
script = ExtResource("1_xop3p")
speaker_name = "Zylrak"
portrait = ExtResource("5_g0xi8")
text = "Je m'en occupe."

[sub_resource type="Resource" id="Resource_ids4w"]
script = ExtResource("1_xop3p")
speaker_name = "Oswin"
portrait = ExtResource("11_lv5tr")
text = "Merci... Merci, Ashwarden. Que les Cendres vous gardent."

[resource]
script = ExtResource("6_8xpea")
lines = Array[ExtResource("1_xop3p")]([SubResource("Resource_ydp5x"), SubResource("Resource_pri3b"), SubResource("Resource_05xdi"), SubResource("Resource_qemya"), SubResource("Resource_of43a"), SubResource("Resource_lv5tr"), SubResource("Resource_n60dh"), SubResource("Resource_q1cs2"), SubResource("Resource_rhjqd"), SubResource("Resource_ids4w")])
forbidden_flags = Array[String](["has_accepted_zylrak_quest"])
flags_on_finish = Array[String](["has_accepted_zylrak_quest"])
auto_start = true
