[sub_resource type="Resource" id="Resource_tlcaw"]
script = ExtResource("1_mew6d")
speaker_name = "Zylrak"
portrait = ExtResource("2_3lhxo")
text = "Un chariot renversé, les caisses éventrées... C'est celui du marchand qu'Oswin attendait."

[sub_resource type="Resource" id="Resource_43dlm"]
script = ExtResource("1_mew6d")
speaker_name = "Zylrak"
portrait = ExtResource("3_81tdr")
text = "Des marques de griffes partout sur le bois. Des goules. Et pas qu'une seule."

[sub_resource type="Resource" id="Resource_3dwfx"]
script = ExtResource("1_mew6d")
speaker_name = "Zylrak"
portrait = ExtResource("2_3lhxo")
text = "Pas de corps. Juste des traces dans la boue, qui partent vers l'est... Ils l'ont traîné."

[sub_resource type="Resource" id="Resource_32hv2"]
script = ExtResource("1_mew6d")
speaker_name = "Zylrak"
portrait = ExtResource("4_uaeie")
text = "Vers les ruines. Torvald avait raison. Avec un peu de chance, il est encore en vie."

