[ext_resource type="Script" path="res://scenes/Dialog/dialogue_conversation.gd" id="3_conv"]

[sub_resource type="Resource" id="Resource_l0"]
script = ExtResource("1_lines")
text = "« Ruines des Yrenn. Passage dangereux : éboulements. »"

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_lines")
text = "Le mot « éboulements » a été barré. Dessous, gravé d'une main mal assurée : « goules »."

[sub_resource type="Resource" id="Resource_l2"]
