[sub_resource type="Resource" id="Resource_m113v"]
script = ExtResource("1_6ynw8")
speaker_name = "Mirabelle"
portrait = ExtResource("2_t4p14")
text = "Tu pars chercher Aldric ? Il me rapportait toujours des fleurs sauvages des bords du lac..."

[sub_resource type="Resource" id="Resource_yrhuf"]
script = ExtResource("1_6ynw8")
speaker_name = "Mirabelle"
portrait = ExtResource("3_yy8it")
text = "Enfin... pour mon jardin, hein. Juste pour le jardin."

[sub_resource type="Resource" id="Resource_kymvg"]
script = ExtResource("1_6ynw8")
speaker_name = "Zylrak"
portrait = ExtResource("4_oxl2b")
text = "Évidemment. Juste pour le jardin."

[sub_resource type="Resource" id="Resource_ngelg"]
script = ExtResource("1_6ynw8")
speaker_name = "Mirabelle"
portrait = ExtResource("5_kyayw")
text = "Ramène-le, Zylrak. S'il te plaît."

