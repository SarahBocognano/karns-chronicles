[sub_resource type="Resource" id="Resource_03fv2"]
script = ExtResource("1_kcsti")
speaker_name = "Mirabelle"
portrait = ExtResource("2_rn8nn")
text = "Oh ! Attention où tu mets les pieds, l'étranger. Tu as failli écraser mes soucis."

[sub_resource type="Resource" id="Resource_m1h5g"]
script = ExtResource("1_kcsti")
speaker_name = "Zylrak"
portrait = ExtResource("3_bynxn")
text = "Des soucis ? J'en ai déjà assez comme ça, merci."

[sub_resource type="Resource" id="Resource_25n57"]
script = ExtResource("1_kcsti")
speaker_name = "Mirabelle"
portrait = ExtResource("4_h7f0w")
text = "Les fleurs, idiot ! Des soucis, des pensées, de la sauge... Tout ce petit monde a soif, même quand le village a peur."

[sub_resource type="Resource" id="Resource_1g78r"]
script = ExtResource("1_kcsti")
speaker_name = "Zylrak"
portrait = ExtResource("5_4qw5b")
text = "Des goules rôdent à deux pas, et toi, tu arroses tes plantes ?"

[sub_resource type="Resource" id="Resource_ur40f"]
script = ExtResource("1_kcsti")
speaker_name = "Mirabelle"
portrait = ExtResource("6_g6inm")
text = "Justement. Si j'arrête, qu'est-ce qui restera quand tout ça sera fini ? Des chardons et des ronces."

[sub_resource type="Resource" id="Resource_qboc6"]
script = ExtResource("1_kcsti")
speaker_name = "Mirabelle"
portrait = ExtResource("7_l7b8b")
text = "Je m'appelle Mirabelle. Si tu te blesses dehors, passe me voir. La sauge, ça soigne mieux que les grands discours."

[sub_resource type="Resource" id="Resource_tddar"]
script = ExtResource("1_kcsti")
speaker_name = "Zylrak"
portrait = ExtResource("8_7owkn")
text = "Zylrak, de l'Ordre des Cendres. Retiens bien ce nom."

[sub_resource type="Resource" id="Resource_d0arl"]
script = ExtResource("1_kcsti")
speaker_name = "Mirabelle"
portrait = ExtResource("2_rn8nn")
text = "Je le planterai dans un coin du jardin. On verra bien s'il pousse."

[resource]
script = ExtResource("9_lec28")
lines = Array[ExtResource("1_kcsti")]([SubResource("Resource_03fv2"), SubResource("Resource_m1h5g"), SubResource("Resource_25n57"), SubResource("Resource_1g78r"), SubResource("Resource_ur40f"), SubResource("Resource_qboc6"), SubResource("Resource_tddar"), SubResource("Resource_d0arl")])
forbidden_flags = Array[String](["talked_to_mirabelle"])
