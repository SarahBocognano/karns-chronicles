[ext_resource type="Texture2D" path="res://assets/portrait/mirabelle_genee.tres" id="p1"]

[sub_resource type="Resource" id="Resource_l0"]
script = ExtResource("1_lines")
speaker_name = "Mirabelle"
portrait = ExtResource("p0")
text = "Aldric est rentré ! Il m'a rapporté des fleurs du lac... en boitant. Il est bête."

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_lines")
speaker_name = "Mirabelle"
portrait = ExtResource("p1")
text = "Pour mon jardin, hein. Juste pour le jardin."

[resource]
