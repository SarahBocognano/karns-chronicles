[gd_resource type="Resource" script_class="DialogueConversation" format=3]

[ext_resource type="Script" path="res://scenes/Dialog/dialog_lines.gd" id="1_lines"]
[ext_resource type="Script" path="res://scenes/Dialog/dialogue_conversation.gd" id="2_conv"]
[ext_resource type="Texture2D" path="res://assets/portrait/colporteur_sourire.tres" id="p0"]
[ext_resource type="Texture2D" path="res://assets/portrait/colporteur_rire.tres" id="p1"]

[sub_resource type="Resource" id="Resource_l0"]
script = ExtResource("1_lines")
speaker_name = "Colporteur"
portrait = ExtResource("p0")
text = "Rubans, aiguilles, savon parfumé ! ... Ah, t'as pas une tête à acheter du savon. Dommage, ça te ferait pas de mal."

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_lines")
speaker_name = "Colporteur"
portrait = ExtResource("p1")
text = "Je plaisante ! Je reprends la route dans trois jours, si le temps tient."

[resource]
script = ExtResource("2_conv")
lines = Array[ExtResource("1_lines")]([SubResource("Resource_l0"), SubResource("Resource_l1")])
