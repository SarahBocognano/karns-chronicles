[gd_resource type="Resource" script_class="DialogueConversation" format=3]

[ext_resource type="Script" path="res://scenes/Dialog/dialog_lines.gd" id="1_lines"]
[ext_resource type="Script" path="res://scenes/Dialog/dialogue_conversation.gd" id="2_conv"]
[ext_resource type="Texture2D" path="res://assets/portrait/zylrak_sourire_en_coin.tres" id="p0"]
[ext_resource type="Texture2D" path="res://assets/portrait/pepin_boudeur.tres" id="p1"]
[ext_resource type="Texture2D" path="res://assets/portrait/pepin_rire.tres" id="p2"]

[sub_resource type="Resource" id="Resource_l0"]
script = ExtResource("1_lines")
speaker_name = "Zylrak"
portrait = ExtResource("p0")
text = "D'accord. Il viendra avec moi."

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_lines")
speaker_name = "Pépin"
portrait = ExtResource("p1")
text = "Prends soin de lui, hein. Il adore renifler partout : il trouve plein de trucs, des fois. Des os, des cailloux, des écus..."

[sub_resource type="Resource" id="Resource_l2"]
script = ExtResource("1_lines")
speaker_name = "Pépin"
portrait = ExtResource("p2")
text = "T'es un vrai chevalier, en fait. Même avec ta cape de rideau."

[sub_resource type="Resource" id="Resource_l3"]
script = ExtResource("1_lines")
text = "Croûton suit désormais Zylrak. Quand il s'arrête et aboie, il y a quelque chose à déterrer."

[resource]
script = ExtResource("2_conv")
lines = Array[ExtResource("1_lines")]([SubResource("Resource_l0"), SubResource("Resource_l1"), SubResource("Resource_l2"), SubResource("Resource_l3")])
