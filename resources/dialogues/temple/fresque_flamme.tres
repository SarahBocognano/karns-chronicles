[ext_resource type="Script" path="res://scenes/Dialog/dialog_lines.gd" id="1_h7c3v"]
[ext_resource type="Texture2D" path="res://assets/portrait/zylrak_reflexion.tres" id="2_5dj7r"]
[ext_resource type="Texture2D" path="res://assets/portrait/ysolde_neutre.tres" id="3_yhvkh"]
[ext_resource type="Script" path="res://scenes/Dialog/dialogue_conversation.gd" id="4_lxepf"]

[sub_resource type="Resource" id="Resource_oeyry"]
script = ExtResource("1_h7c3v")
text = "Des Yrenn agenouillés devant une flamme. Leurs âmes s'élèvent vers les quatre temples. Une inscription court sous leurs pieds."

[sub_resource type="Resource" id="Resource_wryvw"]
script = ExtResource("1_h7c3v")
speaker_name = "Zylrak"
portrait = ExtResource("2_5dj7r")
text = "« Tant que brûle la flamme, la Bête dort. »"

[sub_resource type="Resource" id="Resource_qtjoh"]
script = ExtResource("1_h7c3v")
speaker_name = "Ysolde"
portrait = ExtResource("3_yhvkh")
text = "Ils ont donné leurs âmes pour tenir les sceaux. Pas étonnant que cet endroit soit glacé."

[resource]
script = ExtResource("4_lxepf")
lines = Array[ExtResource("1_h7c3v")]([SubResource("Resource_oeyry"), SubResource("Resource_wryvw"), SubResource("Resource_qtjoh")])
