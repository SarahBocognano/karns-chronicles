[sub_resource type="Resource" id="Resource_0lye3"]
script = ExtResource("1_6yvlk")
text = "Le marchand. Il est mort depuis un jour ou deux, les mains liées, une entaille en travers de la gorge."

[sub_resource type="Resource" id="Resource_2ghmf"]
script = ExtResource("1_6yvlk")
speaker_name = "Zylrak"
portrait = ExtResource("2_eq3xn")
text = "Ils l'ont saigné pour briser le sceau. Le cercle de cendres, dans le vestibule... C'était pour ça."

[sub_resource type="Resource" id="Resource_lcw8o"]
script = ExtResource("1_6yvlk")
speaker_name = "Ysolde"
portrait = ExtResource("3_it2yn")
text = "Ce ne sont pas des goules qui font des nœuds pareils."

[sub_resource type="Resource" id="Resource_l2sb6"]
script = ExtResource("1_6yvlk")
speaker_name = "Zylrak"
portrait = ExtResource("4_wtkmy")
text = "Oswin attendait ses vivres. Il faudra lui dire."

[resource]
script = ExtResource("5_7f8yu")
lines = Array[ExtResource("1_6yvlk")]([SubResource("Resource_0lye3"), SubResource("Resource_2ghmf"), SubResource("Resource_lcw8o"), SubResource("Resource_l2sb6")])
