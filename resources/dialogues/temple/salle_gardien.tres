[sub_resource type="Resource" id="Resource_l5jbp"]
script = ExtResource("1_2osqk")
speaker_name = "Ysolde"
portrait = ExtResource("2_sqv0l")
text = "Regarde le sol... Le même cercle que sur la porte, en grand."

[sub_resource type="Resource" id="Resource_sfded"]
script = ExtResource("1_2osqk")
speaker_name = "Zylrak"
portrait = ExtResource("3_s4lqa")
text = "Et au fond, une armure, debout devant un autel. Et là, par terre... quelqu'un."

[sub_resource type="Resource" id="Resource_lhioe"]
script = ExtResource("1_2osqk")
speaker_name = "Ysolde"
portrait = ExtResource("4_5fiam")
text = "Le marchand. L'armure ne bouge pas, mais je n'aime pas ça."

