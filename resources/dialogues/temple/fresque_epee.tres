[sub_resource type="Resource" id="Resource_w8vrh"]
script = ExtResource("1_pem3k")
text = "Une épée brise l'âme de la Bête en quatre éclats de lumière. Chacun s'envole vers un temple : la lune, le loup, l'épée, la flamme."

[sub_resource type="Resource" id="Resource_fke15"]
