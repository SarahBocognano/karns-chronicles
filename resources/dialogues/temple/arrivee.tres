[sub_resource type="Resource" id="Resource_77ifn"]
script = ExtResource("1_mmopb")
speaker_name = "Zylrak"
portrait = ExtResource("2_i3pn1")
text = "Il fait froid, ici. Et pourtant, les pierres brillent..."

[sub_resource type="Resource" id="Resource_jje6s"]
script = ExtResource("1_mmopb")
speaker_name = "Ysolde"
portrait = ExtResource("3_7p1tp")
text = "Des runes. Elles sont encore allumées, après mille ans."

[sub_resource type="Resource" id="Resource_dobqn"]
script = ExtResource("1_mmopb")
speaker_name = "Zylrak"
portrait = ExtResource("4_3iflv")
text = "Le sang continue tout droit. Reste près de moi."

[sub_resource type="Resource" id="Resource_pjq3n"]
script = ExtResource("1_mmopb")
speaker_name = "Ysolde"
portrait = ExtResource("5_323j5")
text = "Regarde les murs, l'Ashwarden. Les Yrenn y ont gravé des fresques."

