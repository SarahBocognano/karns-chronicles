[sub_resource type="Resource" id="Resource_2meye"]
script = ExtResource("1_yqocl")
speaker_name = "Zylrak"
portrait = ExtResource("2_kkcte")
text = "Un cercle tracé à la cendre... Et du sang au milieu. Celui du marchand, sûrement."

[sub_resource type="Resource" id="Resource_m4q11"]
script = ExtResource("1_yqocl")
speaker_name = "Ysolde"
portrait = ExtResource("3_aridg")
text = "Zylrak... Ce symbole. C'est le même que sur ta cape."

[sub_resource type="Resource" id="Resource_c0u2g"]
script = ExtResource("1_yqocl")
speaker_name = "Zylrak"
portrait = ExtResource("4_75to5")
text = "La flamme de l'Ordre. Mais renversée."

[sub_resource type="Resource" id="Resource_o8npu"]
script = ExtResource("1_yqocl")
speaker_name = "Ysolde"
portrait = ExtResource("5_5g6c7")
text = "D'autres Ashwardens sont passés par ici ?"

[sub_resource type="Resource" id="Resource_h1snv"]
script = ExtResource("1_yqocl")
speaker_name = "Zylrak"
portrait = ExtResource("6_aovia")
text = "Aucun Ashwarden ne ferait ça. Ce cercle ne sert pas à chasser quelque chose. Il sert à l'appeler."

[resource]
script = ExtResource("7_6q7er")
lines = Array[ExtResource("1_yqocl")]([SubResource("Resource_2meye"), SubResource("Resource_m4q11"), SubResource("Resource_c0u2g"), SubResource("Resource_o8npu"), SubResource("Resource_h1snv")])
